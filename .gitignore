# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Editor clutter
*.swp
*~
.vscode/
.idea/

# Archives / local backups — don't need to live in version control
*.zip
*.bak

# Node / build
node_modules/
dist/
.next/
*.log
*.tsbuildinfo

# Env — never commit secrets (committed .env.example files document the vars)
.env
.env.local
.env.*.local

# Local build orchestration (workflow scripts, logs) — not part of the deliverable
.build/

# Generated submission copy (scripts/make-submission-manifest.mjs) — manifest.json is the source.
manifest.submit.json
