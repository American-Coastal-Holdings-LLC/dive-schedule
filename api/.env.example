# Dive Schedule API — copy to .env for local dev. NEVER commit .env.
PORT=4310

# PostgreSQL — this vendor app owns its own database. Include your local role in the URL
# (e.g. your OS username under Homebrew trust auth): postgresql://<role>@localhost:5432/dive_schedule_dev
DATABASE_URL=postgresql://postgres@localhost:5432/dive_schedule_dev

# Logging: debug | info | warn | error
LOG_LEVEL=info

# CSP frame-ancestors: who may embed this app in an iframe. Space-separated origins,
# or 'self'. Empty/unset = do NOT emit a frame-ancestors restriction (dev-friendly:
# the platform workspace + the vendor domain will be listed here in real deployments).
CSP_FRAME_ANCESTORS=

# DEV STUB webhook signature — the placeholder shared secret the dev WebhookVerifier
# accepts in the X-Dev-Signature header. Replaced by real signature verification when
# the Vendor Integration Contract lands.
WEBHOOK_DEV_SIGNATURE=dev
