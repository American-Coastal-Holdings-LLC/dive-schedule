# Dive Schedule API — copy to .env for local dev. NEVER commit .env.
PORT=4310

# PostgreSQL — this vendor app owns its own database. Include your local role in the URL
# (e.g. your OS username under Homebrew trust auth): postgresql://<role>@localhost:5432/dive_schedule_dev
DATABASE_URL=postgresql://postgres@localhost:5432/dive_schedule_dev

# Logging: debug | info | warn | error
LOG_LEVEL=info

# ── Platform identity (Vendor Integration Contract §5) ───────────────────────────────────
#
# EOS_API_BASE is the ONE url you normally set; jwks/bridge-verify/oauth/scoped-api all derive
# from it as ${EOS_API_BASE}/plugin-api/v1/... The individual overrides below exist only for the
# rare case where a single endpoint must diverge.
#
#   local dev-stub platform : http://localhost:4322
#   EOS pilot               : https://workspace-api.54.235.203.98.sslip.io
EOS_API_BASE=http://localhost:4322
# EOS_JWKS_URL=
# EOS_BRIDGE_VERIFY_URL=
# EOS_SCOPED_API_BASE=

# Expected `iss` on a bridge token. Must match what the platform mints.
EOS_ISSUER=eos-plugin-issuer-dev

# Permission namespacing: the wire form is ext.<EOS_VENDOR_SLUG>.<EOS_PLUGIN_SLUG>.<key>.
#
# EOS_PLUGIN_SLUG MUST equal INTERNAL_PERMISSION_PREFIX in api/src/auth/permissions.ts ('dive') —
# the 19 permission constants are compiled against it, and a mismatch makes every permission check
# fail silently. assertSlugCoherence() throws rather than let that happen.
#
# EOS_VENDOR_SLUG is 'ach' — American Coastal Holdings' ASSIGNED vendor slug, confirmed from the
# SprocketSuite vendor box (EOS_VENDOR_SLUG=ach / EOS_PLUGIN_SLUG=sprocketsuite). Both plugins are
# the same legal vendor, so this is reused, never re-minted: a different vendor slug would namespace
# our permissions under an ext.* prefix the platform does not grant.
#
# EOS_PLUGIN_SLUG is per-PLUGIN and still PROPOSED — 'dive' is confirmed at registration and
# immutable thereafter. Permissions therefore land as ext.ach.dive.<key>.
EOS_VENDOR_SLUG=ach
EOS_PLUGIN_SLUG=dive

# ── Identity provider selection ──────────────────────────────────────────────────────────
#
# UNSET = the REAL implementations, for all three. These are opt-IN to insecure stubs, deliberately:
# an unset or mistyped value must land on real verification, never on "anyone can mint a token for
# any tenant" or "any caller can trigger the cascade delete". `npm run start:dev` sets all three for
# you; do NOT set any of them in a deployed environment.
# USE_DEV_IDENTITY_STUB=true    # unverified bridge tokens
# USE_DEV_WEBHOOK_STUB=true     # static X-Dev-Signature instead of an HMAC
# USE_DEV_PLATFORM_STUBS=true   # hardcoded users + tenant profiles

# ── OAuth client credentials (contract §4) ──────────────────────────────────────────────
#
# Issued by the partner portal at registration. Sent as Authorization: Basic base64(id:secret) with
# a JSON body — never in the body, never form-encoded. Boot FAILS in production if these are still
# the dev placeholders.
EOS_CLIENT_ID=dev-client-id
EOS_CLIENT_SECRET=dev-client-secret

# ── Embedding ────────────────────────────────────────────────────────────────────────────
#
# CSP frame-ancestors: who may embed this app in an iframe. Space-separated origins, or 'self'.
# Empty/unset = no frame-ancestors restriction (dev only). In a real deployment this MUST list the
# platform workspace origin, and it must agree with the manifest's embed.origin and the web app's
# NEXT_PUBLIC_APP_ORIGIN — the same origin stated in three places.
#
#   EOS pilot workspace: https://workspace.54.235.203.98.sslip.io
CSP_FRAME_ANCESTORS=

# ── Webhooks (contract §8) ───────────────────────────────────────────────────────────────
#
# Real HMAC verification uses a kid → secret map, JSON: {"whsec_1":"<secret>"}. Rotation is
# self-serve with an overlap window, so TWO entries are valid during a rotation; verify each
# delivery against the secret for ITS OWN kid and reject an unrecognised one.
# EOS_WEBHOOK_SECRETS={"dev-kid":"dev-secret"}

# DEV STUB webhook signature — the placeholder the dev WebhookVerifier accepts in X-Dev-Signature.
# Opt-in only, same posture as the identity stub.
# USE_DEV_WEBHOOK_STUB=true
WEBHOOK_DEV_SIGNATURE=dev
