# ---------------------------------------------------------------------------
# EOS plugin developer kit — example environment
# Copy to .env and fill in. NEVER commit a real .env or any client_secret /
# webhook signing secret (clean-structure listing requirement, contract 02 §9).
#
# Every value here is a configurable placeholder. The kit hardcodes NO host:
# the only endpoints are relative to the configurable /plugin-api/v1/ base.
# ---------------------------------------------------------------------------

# The EOS platform API base URL you are given at onboarding. All scoped-API,
# OAuth, JWKS, and bridge/verify calls are relative to this under /plugin-api/v1.
# In local dev this points at the stub-kit's local OAuth stub (see below).
PLUGIN_API_BASE_URL=https://your-eos-host.example/plugin-api/v1

# The EOS workspace host origin your embed iframe runs inside. The bridge client
# pins postMessage targetOrigin to this and validates every inbound event.origin
# against it. In stub mode this is synthesized locally.
EOS_HOST_ORIGIN=https://workspace.your-eos-host.example

# The token issuer (iss) your backend expects on bridge/access tokens.
EOS_TOKEN_ISSUER=https://your-eos-host.example/plugin-issuer

# Per-installation OAuth2 credentials (issued once on the partner portal).
# Leave blank in the repo; supply locally. Never commit real values.
EOS_CLIENT_ID=
EOS_CLIENT_SECRET=

# The opaque installationId that is the audience (aud) of every token you receive.
EOS_INSTALLATION_ID=inst_local_dev

# Per-installation webhook signing secret (issued once). Local dev uses the
# stub simulator's shared test secret below.
EOS_WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Local stub-kit knobs (dev only — never valid against the real platform)
# ---------------------------------------------------------------------------

# Ports for the local stub servers and the sample app (chosen to avoid the
# eos-* service port range 3000-3009).
STUB_OAUTH_PORT=5102
SAMPLE_WEB_PORT=5100
SAMPLE_API_PORT=5101

# Shared TEST webhook secret used by the stub simulator and the sample handler.
# Clearly non-production; documented as never valid against the real platform.
STUB_WEBHOOK_SECRET=whsec_test_do_not_use_in_prod
